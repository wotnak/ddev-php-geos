#ddev-generated
# Build and install the GEOS PHP extension.
# See https://git.osgeo.org/gitea/geos/php-geos
RUN set -eux ;\
  apt-get update ;\
  apt-get install -y php${DDEV_PHP_VERSION}-dev libgeos-dev ;\
  git clone https://github.com/libgeos/php-geos.git ;\
  # Build the extension.
  ( \
    cd php-geos ;\
    git checkout 1a1c6a95697359892886a2050570007754ce575e ;\
    ./autogen.sh ;\
    ./configure ;\
    make ;\
    make install ;\
  ) ;\
  # Cleanup after build.
  rm -r php-geos ;\
  apt-get purge -y php${DDEV_PHP_VERSION}-dev
