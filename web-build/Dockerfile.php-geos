#ddev-generated
# Build and install the GEOS PHP extension.
# See https://git.osgeo.org/gitea/geos/php-geos
RUN set -eux ;\
  php_dev_package="php${DDEV_PHP_VERSION}-dev" ;\
  php_dev_status="$(dpkg-query -W -f='${db:Status-Status}' "$php_dev_package" 2>/dev/null || true)" ;\
  apt-get update ;\
  apt-get install -y "$php_dev_package" libgeos-dev make ;\
  git clone https://github.com/libgeos/php-geos.git ;\
  # Build the extension.
  ( \
    cd php-geos ;\
    git checkout 1a1c6a95697359892886a2050570007754ce575e ;\
    ./autogen.sh ;\
    ./configure ;\
    make ;\
    make install ;\
  ) ;\
  # Cleanup after build.
  rm -r php-geos ;\
  if [ "$php_dev_status" != installed ]; then \
    apt-get purge -y "$php_dev_package" ;\
  fi
